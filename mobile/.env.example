# Mobile env setup:
#
# 1. Copy this file to .env (committed default / fallback)
# 2. Copy to .env.local for your machine (gitignored) — RECOMMENDED for local API URL:
#    API_BASE_URL=http://localhost:3000
#    Android emulator: API_BASE_URL=http://10.0.2.2:3000
#
# .env.local overrides .env (see main.dart). Both must be listed in pubspec.yaml assets.
#
# PRODUCTION: CI uses .env.production (helixacareai.vercel.app), not .env.local.
API_BASE_URL=http://localhost:3000
